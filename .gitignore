# Rust / Cargo
/target/
**/*.rs.bk
Cargo.lock.orig

# Local test / coverage output
/coverage/
/coverage.json
lcov.info
*.profraw
*.profdata

# Local logs and temporary files
*.log
*.tmp
*.swp
*~
.DS_Store

# Local configuration that may contain machine-specific values
