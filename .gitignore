# override files are not)
!.cargo/config.toml

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
!tests/fixtures/**/*.pem

# Generated API clients / schema tooling output
/generated/

# OS noise
Thumbs.db
desktop.ini

# IDE noise
.vscode/
.idea/
*.iml