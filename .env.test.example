# Sitolo PostgreSQL integration-test harness inputs.
#
# These are test-harness inputs, not application configuration. The canonical
# application contract is the `SITOLO__` namespace documented in .env.example.
# The integration tests read these variables directly and fail closed if any is
# absent.
#
# Provision a disposable PostgreSQL 18 database first. The harness creates and
# drops isolated schemas, and its fixture creates the cluster-scoped
# app_runtime, app_worker, and app_outbox_owner roles, so do not point these at
# a shared or production cluster. Export them in the process environment:
#
#   set -a; . ./.env.test.example; set +a
#   cargo test --workspace --all-targets --all-features --locked
#
# The roles are restricted LOGIN roles (NOINHERIT, NOSUPERUSER, NOBYPASSRLS,
# NOCREATEDB, NOCREATEROLE, NOREPLICATION). The admin URL must be able to
# create/drop schemas and the fixture roles. The CI service uses trust
# authentication on loopback only; a local cluster with password authentication
# needs the matching password added to each URL.

ADMIN_DATABASE_URL=postgres://postgres@127.0.0.1:5432/sitolo_test
RUNTIME_DATABASE_URL=postgres://app_runtime@127.0.0.1:5432/sitolo_test
WORKER_DATABASE_URL=postgres://app_worker@127.0.0.1:5432/sitolo_test
