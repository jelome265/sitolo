# Sitolo application configuration reference for local development.
#
# This file is documentation, not a loader. Sitolo reads configuration from
# the process environment only; copying this file to `.env` does not configure
# the application. Export the variables in your shell (or use your process
# supervisor) before starting a binary, for example:
#
#   set -a; . ./.env.example; set +a
#   cargo run -p sitolo-api-bin
#
# The canonical contract lives in crates/sitolo-config. Unknown `SITOLO__`
# keys fail startup. Values in the disjoint `SITOLO_SECRET__` namespace are
# development secret-provider inputs, never ordinary configuration.
#
# Replace every placeholder. Never commit a real credential.

# --- Runtime identity -------------------------------------------------------
SITOLO__RUNTIME__ENVIRONMENT=development
SITOLO__RUNTIME__SERVICE_NAME=sitolo-api
SITOLO__RUNTIME__SERVICE_VERSION=0.1.0-dev
SITOLO__RUNTIME__CONFIG_SCHEMA_VERSION=2
SITOLO__LOG__LEVEL=info

# --- HTTP listener ----------------------------------------------------------
SITOLO__HTTP__BIND_ADDRESS=127.0.0.1:8080
SITOLO__HTTP__MAX_BODY_BYTES=2097152
SITOLO__HTTP__REQUEST_HEADER_TIMEOUT_MS=5000
SITOLO__HTTP__KEEPALIVE_TIMEOUT_MS=30000

# --- PostgreSQL runtime intent (non-secret identity) ------------------------
# The application stores only the secret *reference*. The development provider
# resolves the value from SITOLO_SECRET__DATABASE__PASSWORD below.
SITOLO__DATABASE__HOST=localhost
SITOLO__DATABASE__PORT=5432
SITOLO__DATABASE__NAME=sitolo
SITOLO__DATABASE__USER=sitolo_app_runtime
SITOLO__DATABASE__PASSWORD_REF=development/sitolo/db
SITOLO__DATABASE__POOL_MIN=5
SITOLO__DATABASE__POOL_MAX=20
SITOLO__DATABASE__ACQUIRE_TIMEOUT_MS=2000

# --- Telemetry (optional) ---------------------------------------------------
# Leave the endpoint empty to disable OTLP export. Remote endpoints require TLS.
SITOLO__TELEMETRY__OTLP_ENDPOINT=
SITOLO__TELEMETRY__EXPORT_TIMEOUT_MS=3000
SITOLO__TELEMETRY__MAX_QUEUE=2048
SITOLO__TELEMETRY__TRACE_SAMPLE_RATIO=0.1

# --- Development secret provider -------------------------------------------
# Development-only. Production must set this to false. The development
# provider is rejected in production, and no managed production secret adapter
# exists yet, so production startup fails closed rather than reading this value.
SITOLO__SECRETS__ALLOW_LOCAL_PROVIDER=true

# Placeholder only. Use a disposable local database password; do not commit it.
# The dedicated SITOLO_SECRET__ namespace is read by the development secret
# provider and is deliberately outside the SITOLO__ configuration namespace.
SITOLO_SECRET__DATABASE__PASSWORD=replace-with-local-disposable-password

# The worker is a separate binary. To enable it, supply the worker-only
# password reference and all relay destination settings together; queue/topic
# identifiers and secret references are deployment inputs. This API sample
# intentionally leaves the relay disabled and is not a production manifest.
