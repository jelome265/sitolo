#!/usr/bin/env bash
set -euo pipefail
trap 'echo "SYSTEM MAP PROCESS VERIFIER ERROR at ${BASH_SOURCE[0]}:${LINENO}: ${BASH_COMMAND}" >&2' ERR

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

fail=0
current_tree="HEAD"

process_files=()
while IFS= read -r process; do
  [[ "$process" == "map/processes/CONTEXT.md" ]] || process_files+=("$process")
done < <(find map/processes -maxdepth 1 -type f -name '*.md' | sort)

for process in "${process_files[@]}"; do
  get_field() {
    local field="$1"
    sed -n "s/^$field: //p" "$process" | head -n 1
  }

  type="$(get_field type)"
  status="$(get_field status)"
  universe="$(get_field universe)"
  source_revision="$(get_field source_revision)"
  source="$(get_field source)"
  source_citation="$(get_field source_citation)"

  [[ "$type" == "process" ]] || {
    echo "SYSTEM MAP PROCESS VIOLATION: type is not process: $process" >&2
    fail=1
  }

  case "$status" in
    stub|verified|stale) ;;
    *)
      echo "SYSTEM MAP PROCESS VIOLATION: invalid status '$status': $process" >&2
      fail=1
      ;;
  esac

  case "$universe" in
    live|leftover|ghost) ;;
    *)
      echo "SYSTEM MAP PROCESS VIOLATION: invalid universe '$universe': $process" >&2
      fail=1
      ;;
  esac

  [[ -n "$source_citation" ]] || {
    echo "SYSTEM MAP PROCESS VIOLATION: missing source_citation: $process" >&2
    fail=1
  }

  source_sha="$(printf '%s' "$source_revision" | sed -n 's/.*@\([0-9a-fA-F]\{40\}\)$/\1/p')"
  if [[ -z "$source_sha" ]]; then
    source_sha="$(printf '%s' "$source_revision" | grep -Eo '^[0-9a-fA-F]{40}$' || true)"
  fi
  if [[ -z "$source_sha" ]]; then
    echo "SYSTEM MAP PROCESS VIOLATION: source_revision must contain a concrete commit SHA: $process -> $source_revision" >&2
    fail=1
  elif ! git cat-file -e "$source_sha^{commit}" 2>/dev/null; then
    # PR jobs intentionally use shallow checkout. Fetch only the exact
    # immutable revision named by the card instead of requiring full history.
    git fetch --no-tags --depth=1 origin "$source_sha" >/dev/null 2>&1 || true
    if ! git cat-file -e "$source_sha^{commit}" 2>/dev/null; then
      echo "SYSTEM MAP PROCESS VIOLATION: source revision does not resolve after targeted fetch: $process -> $source_revision" >&2
      fail=1
    fi
  fi

  [[ -n "$source" ]] || {
    echo "SYSTEM MAP PROCESS VIOLATION: missing source: $process" >&2
    fail=1
  }

  IFS=';' read -r -a source_list <<< "$source"
  for source_path in "${source_list[@]}"; do
    source_path="$(printf '%s' "$source_path" | sed 's/^ *//; s/ *$//')"
    [[ -f "$source_path" ]] || {
      echo "SYSTEM MAP PROCESS VIOLATION: current source missing: $process -> $source_path" >&2
      fail=1
      continue
    }

    if [[ -n "$source_sha" ]] && git cat-file -e "$source_sha:$source_path" 2>/dev/null; then
      source_blob="$(git rev-parse "$source_sha:$source_path")"
      current_blob="$(git rev-parse "$current_tree:$source_path")"
      if [[ "$status" != "stale" && "$source_blob" != "$current_blob" ]]; then
        echo "SYSTEM MAP PROCESS VIOLATION: non-stale card points to an obsolete source revision: $process -> $source_path" >&2
        echo "  card=$source_sha current=$current_blob" >&2
        fail=1
      fi
    else
      echo "SYSTEM MAP PROCESS VIOLATION: source did not exist at recorded revision: $process -> $source_path" >&2
      fail=1
    fi
  done

  for section in "## Input" "## Movement" "## Output" "## Consumes" "## Produces" "## If you change this" "### Hits" "### Does not hit" "## Verification" "## See"; do
    grep -Fqx "$section" "$process" || {
      echo "SYSTEM MAP PROCESS VIOLATION: missing $section: $process" >&2
      fail=1
    }
  done

  movement="$(sed -n '/^## Movement$/,/^## Output$/p' "$process")"
  printf '%s\n' "$movement" | grep -Eq '^[[:space:]]*[0-9]+\. ' || {
    echo "SYSTEM MAP PROCESS VIOLATION: no numbered movement: $process" >&2
    fail=1
  }

  while IFS= read -r step; do
    [[ -z "$step" ]] && continue
    if ! printf '%s\n' "$step" | grep -Eq '\([^)]*(/|\.md|\.rs|\.toml|\.yml|\.yaml)[^)]*\)'; then
      echo "SYSTEM MAP PROCESS VIOLATION: movement step lacks an inline source citation: $process -> $step" >&2
      fail=1
    fi
  done < <(printf '%s\n' "$movement" | grep -E '^[[:space:]]*[0-9]+\. ' || true)

  for section in "## Consumes" "## Produces"; do
    body="$(sed -n "/^$section$/,/^## /p" "$process" | tail -n +2)"
    links="$(printf '%s\n' "$body" | grep -oE '\]\(\.\./objects/[^)]+\.md\)' || true)"
    [[ -n "$links" ]] || {
      echo "SYSTEM MAP PROCESS VIOLATION: $section lacks object links: $process" >&2
      fail=1
      continue
    }
    while IFS= read -r link; do
      target="$(printf '%s' "$link" | sed -n 's|.*](\(\.\./objects/[^)]*\.md\))|\1|p')"
      [[ -f "map/processes/$target" ]] || {
        echo "SYSTEM MAP PROCESS VIOLATION: broken object link: $process -> $target" >&2
        fail=1
      }
    done <<< "$links"
  done

  hits="$(sed -n '/^### Hits$/,/^### Does not hit$/p' "$process" | tail -n +2 | sed '/^### Does not hit$/d')"
  misses="$(sed -n '/^### Does not hit$/,/^## Verification$/p' "$process" | tail -n +2 | sed '/^## Verification$/d')"
  [[ -n "$(printf '%s' "$hits" | tr -d '[:space:]')" ]] || {
    echo "SYSTEM MAP PROCESS VIOLATION: empty Hits: $process" >&2
    fail=1
  }
  [[ -n "$(printf '%s' "$misses" | tr -d '[:space:]')" ]] || {
    echo "SYSTEM MAP PROCESS VIOLATION: empty Does not hit: $process" >&2
    fail=1
  }

  if [[ "$status" == "verified" ]]; then
    [[ "$universe" == "live" ]] || {
      echo "SYSTEM MAP PROCESS VIOLATION: verified process must be live: $process" >&2
      fail=1
    }
    if grep -q 'Ghost/unwired' "$process"; then
      echo "SYSTEM MAP PROCESS VIOLATION: verified process still claims ghost/unwired: $process" >&2
      fail=1
    fi
  fi

  if [[ "$universe" == "ghost" ]]; then
    grep -q 'Ghost/unwired' "$process" || {
      echo "SYSTEM MAP PROCESS VIOLATION: ghost process lacks explicit unwired evidence: $process" >&2
      fail=1
    }
  fi
done

# Explicit current-state negative evidence for the four process cards in PR #52.
# These assertions intentionally fail when a process becomes materially wired,
# forcing its card to be reclassified instead of silently leaving a stale stub.
if [[ -f crates/sitolo-sync/src/lib.rs ]]; then
  if grep -Eq '^[[:space:]]*(pub[[:space:]]+)?(fn|struct|enum|trait|impl|type|const|static)[[:space:]]' crates/sitolo-sync/src/lib.rs; then
    echo "SYSTEM MAP PROCESS VIOLATION: offline-sync source is no longer contract-only; reclassify the process card." >&2
    fail=1
  fi
fi

if [[ -f apps/worker/src/main.rs && -f crates/sitolo-events/src/lib.rs ]]; then
  grep -Fq 'fn main() {}' apps/worker/src/main.rs || {
    echo "SYSTEM MAP PROCESS VIOLATION: outbox worker is no longer the expected empty scaffold; reclassify the process card." >&2
    fail=1
  }
  if grep -Eq '^[[:space:]]*(pub[[:space:]]+)?(fn|struct|enum|trait|impl|type|const|static)[[:space:]]' crates/sitolo-events/src/lib.rs; then
    echo "SYSTEM MAP PROCESS VIOLATION: events source now contains runtime definitions; reclassify the outbox process card." >&2
    fail=1
  fi
fi

if [[ -f apps/api/src/serve.rs ]]; then
  grep -Fq 'TcpListener' apps/api/src/serve.rs || {
    echo "SYSTEM MAP PROCESS VIOLATION: request-processing source no longer matches the direct-TCP implementation baseline; re-audit the card." >&2
    fail=1
  }
  if grep -Eq 'extract_bearer\(|establish_context\(' apps/api/src; then
    echo "SYSTEM MAP PROCESS VIOLATION: authenticated request processing is now wired into the API runtime; reclassify the process card." >&2
    fail=1
  fi
fi

if grep -Rqs 'Transaction<' apps/api/src 2>/dev/null || grep -Rqs 'sitolo-events' apps/api/src 2>/dev/null; then
  echo "SYSTEM MAP PROCESS VIOLATION: API now contains transactional/event coupling that may materially wire transactional-mutation; re-audit the process card." >&2
  fail=1
fi

if [[ "$fail" -ne 0 ]]; then
  echo "System Map process verification FAILED" >&2
  exit 1
fi

echo "System Map process verification PASSED"
echo "4 process cards remain explicitly stub/ghost with source-grounded unwired evidence"
