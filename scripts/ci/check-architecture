#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../" && pwd)"
cd "$ROOT"

# Crates that must not depend on infrastructure or provider machinery.
PURE_CRATES=(
  "sitolo-domain"
)

# Forbidden infrastructure/provider crates in the pure layers (Phase 1 spec section 6).
# Extend this allowlist of crate-name tokens with care.
FORBIDDEN='\b(axum|sqlx|redis|reqwest|hyper|tokio-postgres|ureq)\b'

fail=0
for crate in "${PURE_CRATES[@]}"; do
  tree="$(cargo tree --locked -p "$crate" 2>/dev/null || true)"
  if grep -qiE "$FORBIDDEN" <<<"$tree"; then
    echo "ARCHITECTURE VIOLATION: $crate depends on a forbidden infrastructure crate:"
    echo "$tree" | grep -qiE "$FORBIDDEN" && echo "$tree" | grep -iE "$FORBIDDEN"
    fail=1
  fi
done

# F-021: exactly one platform implementation. Global logging installation
# lives only in apps/ (crates emit via `tracing`; test-only local
# subscribers built with `finish()` install nothing global and are allowed).
# Configuration fingerprinting lives only in sitolo-config
# (`reference_fingerprint` in sitolo-security is a secret-reference
# correlator, not a config fingerprint, and is allowlisted).
search_pattern() {
  local pattern="$1"
  shift
  if command -v rg >/dev/null 2>&1; then
    rg -n "$pattern" "$@" -g '*.rs' || true
  else
    grep -rnE "$pattern" "$@" --include='*.rs' || true
  fi
}

dupes="$(search_pattern 'try_init\(\)|set_global_default' crates)"
[[ -z "$dupes" ]] || { echo "ARCHITECTURE VIOLATION: logging installation outside apps/:$dupes"; exit 1; }
# Column-0 match: only free-function constructors trip this. Method
# accessors such as `AppState::config_fingerprint` are indented and are
# safe views over the single canonical value.
dupes="$(search_pattern '^(pub )?fn (config_fingerprint|canonical_non_secret_config)\b' crates apps | grep -v 'crates/sitolo-config/' || true)"
[[ -z "$dupes" ]] || { echo "ARCHITECTURE VIOLATION: config fingerprint outside sitolo-config:$dupes"; exit 1; }

if [ "$fail" -ne 0 ]; then
  echo "Architecture check FAILED"
  exit 1
fi

echo "Architecture check PASSED"