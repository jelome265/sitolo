#!/usr/bin/env python3
from __future__ import annotations

import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parents[2]
OBJECTS = ROOT / "map" / "objects"
INDEX = OBJECTS / "_index.md"

rows: list[tuple[str, str, str, str]] = []
for path in sorted(OBJECTS.rglob("*.md")):
    if path.name in {"CONTEXT.md", "_index.md"}:
        continue
    text = path.read_text(encoding="utf-8")
    if "- type: object" not in text:
        continue

    title_match = re.search(r"^# (.+)$", text, re.MULTILINE)
    status_match = re.search(r"^- status: (.+)$", text, re.MULTILINE)
    cluster_match = re.search(r"^- cluster: (.+)$", text, re.MULTILINE)
    if not (title_match and status_match and cluster_match):
        raise SystemExit(f"object card missing metadata: {path}")

    rows.append((
        status_match.group(1).strip(),
        title_match.group(1).strip(),
        cluster_match.group(1).strip(),
        path.relative_to(ROOT).as_posix(),
    ))

content = [
    "# Sitolo Object Index",
    "",
    "Catalog only. Detailed behavior stays in source files.",
    "",
    "| Status | Object | Cluster | Source |",
    "|---|---|---|---|",
]
for status, title, cluster, source in rows:
    content.append(f"| {status} | {title} | {cluster} | {source} |")
content += [
    "",
    "Generated by scripts/ci/generate-system-map-index. Do not hand-edit.",
    "Cards are verified against the current Sitolo source tree at the revision recorded on each card. The cards remain navigational and never replace the source.",
]
INDEX.write_text("\n".join(content) + "\n", encoding="utf-8")
print(f"Generated {INDEX.relative_to(ROOT)} from {len(rows)} object cards.")
