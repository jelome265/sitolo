#!/usr/bin/env python3
from __future__ import annotations

import pathlib
import re

ROOT = pathlib.Path(__file__).resolve().parents[2]
OBJECTS = ROOT / "map" / "objects"
INDEX = OBJECTS / "_index.md"

rows: list[tuple[str, str, str, str, str]] = []
for path in sorted(OBJECTS.rglob("*.md")):
    if path.name in {"CONTEXT.md", "_index.md"}:
        continue
    text = path.read_text(encoding="utf-8")
    if not re.search(r"^---\n(?:.*\n)*?type:\s*object\s*$", text, re.MULTILINE):
        continue

    title_match = re.search(r"^# (.+)$", text, re.MULTILINE)
    status_match = re.search(r"^status:\s*(.+)$", text, re.MULTILINE)
    cluster_match = re.search(r"^cluster:\s*(.+)$", text, re.MULTILINE)
    universe_match = re.search(r"^universe:\s*(.+)$", text, re.MULTILINE)
    if not (title_match and status_match and cluster_match and universe_match):
        raise SystemExit(f"object card missing frontmatter metadata: {path}")

    rows.append((
        status_match.group(1).strip(),
        title_match.group(1).strip(),
        cluster_match.group(1).strip(),
        universe_match.group(1).strip(),
        path.relative_to(ROOT).as_posix(),
    ))

content = [
    "# Sitolo Object Index",
    "",
    "Catalog only. Detailed behavior stays in source files.",
    "",
    "| Status | Universe | Object | Cluster | Source |",
    "|---|---|---|---|---|",
]
for status, title, cluster, universe, source in rows:
    content.append(f"| {status} | {universe} | {title} | {cluster} | {source} |")
content += [
    "",
    "Generated by scripts/ci/generate-system-map-index. Do not hand-edit.",
    "Cards remain navigational; the subject tree is authoritative.",
]
INDEX.write_text("\n".join(content) + "\n", encoding="utf-8")
print(f"Generated {INDEX.relative_to(ROOT)} from {len(rows)} object cards.")
