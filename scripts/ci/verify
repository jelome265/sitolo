#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../" && pwd)"
cd "$ROOT"

echo "==> ICM workspace"
./scripts/ci/check-icm-workspace

echo "==> Verify toolchain"
rustc --version
cargo --version

echo "==> Architecture check (early, fail-closed)"
./scripts/ci/check-architecture

echo "==> Versioned schema migration inventory"
python3 ./scripts/ci/check-schema-migrations.py

echo "==> Rust lint and unsafe-code policy"
python3 ./scripts/ci/check-rust-policy.py

echo "==> Verify lockfile (fails if stale)"
cargo metadata --format-version 1 --locked >/dev/null

echo "==> Format check"
cargo fmt --all -- --check

echo "==> Lint"
cargo clippy --workspace --all-targets --all-features --locked -- -D warnings

echo "==> Compile"
cargo check --workspace --all-targets --all-features --locked

echo "==> Unit tests"
cargo test --workspace --all-targets --all-features --locked

echo "==> Phase 4 Part 8 PostgreSQL integration suite"
cargo test -p sitolo-persistence --test part8_postgres_integration_tests --all-features --locked

echo "==> PostgreSQL RLS Security Suite"
cargo test -p sitolo-persistence --test rls_security_tests --all-features --locked

echo "==> Release build"
cargo build --workspace --release --locked

echo "==> Phase 2 policy check"
./scripts/ci/check-phase2-policy

echo "==> Dependency and license policy"
python3 ./scripts/ci/install-policy-tools.py
cargo deny check
cargo audit

echo "==> All verification passed"
