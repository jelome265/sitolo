#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../" && pwd)"
cd "$ROOT"

echo "==> Verify toolchain"
rustc --version
cargo --version

echo "==> Verify lockfile (fails if stale)"
cargo metadata --format-version 1 --locked >/dev/null

echo "==> Format check"
cargo fmt --all -- --check

echo "==> Lint"
cargo clippy --workspace --all-targets --all-features --locked -- -D warnings

echo "==> Compile"
cargo check --workspace --all-targets --all-features --locked

echo "==> Unit tests"
cargo test --workspace --all-targets --all-features --locked

echo "==> PostgreSQL RLS Security Suite"
cargo test -p sitolo-persistence --test rls_security_tests --locked

echo "==> Release build"
cargo build --workspace --release --locked

echo "==> Architecture check"
./scripts/ci/check-architecture

echo "==> Phase 2 policy check"
./scripts/ci/check-phase2-policy

echo "==> Dependency and license policy"
if command -v cargo-deny >/dev/null 2>&1; then
  cargo deny check
else
  echo "FAIL-CLOSED: cargo-deny is required for verification pipeline execution" >&2
  exit 1
fi

if command -v cargo-audit >/dev/null 2>&1; then
  cargo audit
else
  echo "FAIL-CLOSED: cargo-audit is required for verification pipeline execution" >&2
  exit 1
fi

echo "==> All verification passed"
