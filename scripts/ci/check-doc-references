#!/usr/bin/env python3\n"""Validate and inventory internal Markdown document references.\n\nThe checker distinguishes explicit relative Markdown links, path-qualified .md\nreferences, bare document names, missing references, and ambiguous basenames.\nExternal URLs are ignored. Filename resolution never establishes authority.\n"""\nfrom __future__ import annotations\n\nimport argparse\nimport pathlib\nimport re\nimport sys\nfrom collections import defaultdict\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nSKIP_PARTS = {".git", "target"}\n\nLINK = re.compile(r"\[[^\]]*\]\(([^)\s#]+)(?:#[^)]*)?\)")
REF_LINK = re.compile(r"^\s{0,3}\[[^\]]+\]:\s*(\S+\.md(?:#[^\s]+)?)\s*$", re.MULTILINE)
WIKILINK = re.compile(r"\[\[([^\]|]+\.md)(?:#[^\]|]+)?(?:\|[^\]]*)?\]\]")\nCODE_MD = re.compile(r"`([^`\n]*?\.md(?:#[^`]*)?)`")\nPATH_MD = re.compile(r"(?<![\w./-])((?:\.?\.?/)?(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+\.md)(?![\w.-])")\n\ndef ignored(path: pathlib.Path) -> bool:\n    return any(part in SKIP_PARTS for part in path.parts)\n\ndef relative_path(path: pathlib.Path) -> str:\n    return path.relative_to(ROOT).as_posix()\n\ndef in_root(path: pathlib.Path) -> bool:\n    try:\n        path.relative_to(ROOT)\n        return True\n    except ValueError:\n        return False\n\ndef resolve_explicit(source: pathlib.Path, ref: str) -> pathlib.Path | None:\n    if not ref or ref.startswith(("http://", "https://", "mailto:", "#")):\n        return None\n    candidate = ROOT / ref.lstrip("/") if ref.startswith("/") else source.parent / ref\n    return candidate.resolve()\n\ndef resolve_document_reference(source: pathlib.Path, ref: str, by_basename: dict[str, list[pathlib.Path]]) -> tuple[str, pathlib.Path | None, list[pathlib.Path]]:\n    ref = ref.split("#", 1)[0].strip()\n    if not ref:\n        return "ignored", None, []\n    if "/" in ref:\n        if ref.startswith("/"):\n            candidate = (ROOT / ref.lstrip("/")).resolve()\n        elif ref.startswith(("./", "../")):\n            candidate = (source.parent / ref).resolve()\n        elif ref.startswith(("docs/", "workspaces/", "map/")):\n            candidate = (ROOT / ref).resolve()\n        else:\n            candidate = (source.parent / ref).resolve()\n        return "path", candidate, []\n    local = (source.parent / ref).resolve()\n    if local.exists():\n        return "local", local, []\n    candidates = by_basename.get(ref, [])\n    if len(candidates) == 1:\n        return "basename", candidates[0], candidates\n    if len(candidates) > 1:\n        return "ambiguous", None, candidates\n    return "missing", local, []\n\ndef main() -> int:\n    parser = argparse.ArgumentParser()\n    parser.add_argument("--inventory", action="store_true", help="print every resolved reference")\n    args = parser.parse_args()\n\n    files = sorted(p for p in ROOT.rglob("*.md") if p.is_file() and not ignored(p))\n    by_basename: dict[str, list[pathlib.Path]] = defaultdict(list)\n    for path in files:\n        by_basename[path.name].append(path)\n\n    errors: list[str] = []\n    references: list[tuple[pathlib.Path, str, str, pathlib.Path]] = []\n\n    for source in files:\n        text = source.read_text(encoding="utf-8", errors="replace")\n        explicit_refs = set(LINK.findall(text))\n        code_refs = {m.group(1) for m in CODE_MD.finditer(text)}\n        path_refs = {m.group(1) for m in PATH_MD.finditer(text)}\n        for ref in sorted(explicit_refs):\n            target = resolve_explicit(source, ref.split("#", 1)[0])\n            if target is None:\n                continue\n            if not in_root(target):\n                errors.append(f"{relative_path(source)}: document link escapes repository -> {ref}")\n            elif not target.exists():\n                errors.append(f"{relative_path(source)}: broken Markdown link -> {ref}")\n            else:\n                references.append((source, ref, "path", target))\n        for ref in sorted((code_refs | path_refs) - explicit_refs):\n            if ".md" not in ref:\n                continue\n            mode, target, candidates = resolve_document_reference(source, ref, by_basename)\n            if mode == "ignored":\n                continue\n            if mode == "ambiguous":\n                names = ", ".join(relative_path(p) for p in candidates)\n                errors.append(f"{relative_path(source)}: ambiguous document reference -> {ref} [{names}]")\n            elif target is None or not in_root(target) or not target.exists():\n                errors.append(f"{relative_path(source)}: missing document reference -> {ref}")\n            else:\n                references.append((source, ref, mode, target))\n\n    counts = defaultdict(int)\n    for _, _, mode, _ in references:\n        counts[mode] += 1\n    print(f"DOCUMENT REFERENCE INVENTORY: {len(files)} Markdown files, {len(references)} resolved references, {len(errors)} unresolved/ambiguous errors")\n    print("  path={} local={} basename={}".format(counts["path"], counts["local"], counts["basename"]))\n    if args.inventory:\n        for source, ref, mode, target in sorted(references, key=lambda x: (relative_path(x[0]), x[1], x[2])):\n            print(f"{relative_path(source)} -> {ref} [{mode}] => {relative_path(target)}")\n    if errors:\n        print("DOCUMENT REFERENCE CHECK FAILED")\n        for error in errors:\n            print(f"- {error}")\n        return 1\n    print("DOCUMENT REFERENCE CHECK PASSED")\n    return 0\n\nif __name__ == "__main__":\n    sys.exit(main())\n