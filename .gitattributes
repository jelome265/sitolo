# Normalize line endings to LF in the repository; check out native on Windows.
* text=auto eol=lf

# Binary and media files must not be touched by text normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.apk binary
*.a binary
*.so binary
*.dll binary
*.exe binary
*.zip binary
*.wasm binary

# Lockfile is a reproducibility boundary; treat carefully.
Cargo.lock linguist-generated